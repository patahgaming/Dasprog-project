# Salin file ini menjadi .env lalu sesuaikan dengan jaringan X100C lokal:
#   cp .env.example .env   (Windows: Copy-Item .env.example .env)
# File .env TIDAK di-commit (masuk .gitignore) karena berisi kredensial alat.
#
# mode: "simulasi" (tanpa alat) atau "soap" (X100C lewat LAN/webserver)
PAYGUARD_X100C_MODE=simulasi
PAYGUARD_X100C_HOST=192.168.1.201
PAYGUARD_X100C_PORT=80
# Ganti dengan PC connection / comm key di mesin X100C kamu (jangan commit!)
PAYGUARD_X100C_COM_KEY=0
PAYGUARD_X100C_TIMEOUT=6
PAYGUARD_X100C_JENDELA_DETIK=30
PAYGUARD_X100C_BATAS_TUNGGU_DETIK=20
